# Copy this file to .env and fill in the real values.
# NEVER commit the .env file — it is in .gitignore.

# --- Database ---
DATABASE_URL=postgresql+pg8000://user:password@localhost:5433/ai_receptionist

# --- Auth ---
# Generate with: openssl rand -hex 32
SECRET_KEY=

# --- Public URL (used for Vapi webhook) ---
# Set to your ngrok URL during dev, or your production domain.
# e.g. https://abc123.ngrok.io
PUBLIC_URL=

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Vapi ---
VAPI_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AI & Speech ---
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Services ---
RESEND_API_KEY=
GOOGLE_CALENDAR_ID=4fd17f714e1aaaf1d477e7ca00923cf64d6fd120691e95327c9369d3d6d0cfb8@group.calendar.google.com
# GOOGLE_APPLICATION_CREDENTIALS=google-key.json # Deprecated, use JSON directly for security
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'
ENVIRONMENT=development

# --- Firebase ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
